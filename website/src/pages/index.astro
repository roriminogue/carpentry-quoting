---
import { business, services, deckEstimate } from '../config';

const smsBody = `Hi ${business.owner}, I'd like a quote for: `;
const smsHref = `sms:${business.phone.replace(/\s/g, '')}?&body=${encodeURIComponent(smsBody)}`;
const quoteHref = business.enquiryUrl || smsHref;
const telHref = `tel:${business.phone.replace(/\s/g, '')}`;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{business.name} | Carpenter in {business.area}</title>
    <meta
      name="description"
      content={`Licensed carpenter in ${business.area}. Decks, pergolas, doors and small renovations. Free measure and quote.`}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="top">
      <div class="wrap top-inner">
        <a href="#" class="brand">{business.name}</a>
        <a class="btn btn-small" href={telHref}>Call {business.phone}</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap">
          <p class="eyebrow">Licensed carpenter · {business.area}</p>
          <h1>Decks, doors and carpentry, done properly.</h1>
          <p class="lede">
            Local and licensed. Tell me about the job and I'll get back to you within one
            business day to book a free measure and quote.
          </p>
          <div class="cta-row">
            <a class="btn" href={quoteHref} data-quote>Request a free quote</a>
            <a class="btn btn-ghost" href="#estimate">Ballpark a deck price</a>
          </div>
        </div>
      </section>

      <section class="wrap section" aria-labelledby="services-h">
        <h2 id="services-h">What I do</h2>
        <div class="grid">
          {services.map((s) => (
            <article class="card">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="band section" aria-labelledby="how-h">
        <div class="wrap">
          <h2 id="how-h">How quoting works</h2>
          <ol class="steps">
            <li><strong>Send the details.</strong> What you need, roughly how big, your suburb and a few photos.</li>
            <li><strong>Free measure-up.</strong> I come out, measure and talk through options and materials.</li>
            <li><strong>Written quote in 1–2 days.</strong> Clear fixed price, what's included, valid for 30 days. Accept online.</li>
            <li><strong>Book in.</strong> 10% deposit locks in your start date. The balance is due when the job's done.</li>
          </ol>
        </div>
      </section>

      <section id="estimate" class="wrap section" aria-labelledby="est-h">
        <h2 id="est-h">Deck ballpark calculator</h2>
        <p class="muted">
          A rough guide for a typical deck. Your actual quote depends on the site, access and design, and is
          confirmed after a free measure-up.
        </p>
        <form class="estimator" id="estimator" onsubmit="return false">
          <label>Length (m)<input name="length" type="number" inputmode="decimal" min="1" max="30" step="0.1" value="5" /></label>
          <label>Width (m)<input name="width" type="number" inputmode="decimal" min="1" max="30" step="0.1" value="4" /></label>
          <label>Boards
            <select name="board">
              {Object.keys(deckEstimate.perM2).map((b) => <option selected={b === 'Merbau'}>{b}</option>)}
            </select>
          </label>
          <label>Height
            <select name="height">
              <option value="low">Under 1 m off the ground</option>
              <option value="high">Over 1 m off the ground</option>
            </select>
          </label>
          <label>Steps<input name="steps" type="number" inputmode="numeric" min="0" max="20" value="2" /></label>
          <label>Balustrade (m)<input name="bal" type="number" inputmode="decimal" min="0" max="60" step="0.5" value="0" /></label>
        </form>
        <div class="result" aria-live="polite">
          <p class="result-label">Ballpark, including GST</p>
          <p class="result-value" id="est-range">–</p>
          <p class="muted small" id="est-note"></p>
          <a class="btn" href={quoteHref} data-quote id="est-cta">Get an exact quote</a>
        </div>
      </section>

      <section class="band section" aria-labelledby="about-h">
        <div class="wrap narrow">
          <h2 id="about-h">About</h2>
          <p>
            I'm {business.owner}, a licensed carpenter working across {business.area}. I run a small, one-person
            business, so the person who quotes your job is the person who builds it.
          </p>
          <p>
            Every job gets a written quote. Jobs over $5,000 get a proper NSW home building contract, and jobs over
            $20,000 are covered by Home Building Compensation insurance.
          </p>
        </div>
      </section>

      <section class="wrap section contact" aria-labelledby="contact-h">
        <h2 id="contact-h">Get a quote</h2>
        <p>The quickest way is the quote form: it takes two minutes and you can add photos.</p>
        <div class="cta-row">
          <a class="btn" href={quoteHref} data-quote>Request a free quote</a>
          <a class="btn btn-ghost" href={telHref}>Call {business.phone}</a>
          <a class="btn btn-ghost" href={`mailto:${business.email}?subject=Quote%20request`}>Email</a>
        </div>
        {business.googleReviews && (
          <p><a href={business.googleReviews}>Read reviews on Google</a></p>
        )}
      </section>
    </main>

    <footer class="foot">
      <div class="wrap">
        <p>
          © {year} {business.name} · ABN {business.abn} · NSW Contractor Licence {business.licence}
        </p>
        {business.instagram && <p><a href={business.instagram}>Instagram</a></p>}
      </div>
    </footer>

    <script is:inline define:vars={{ est: deckEstimate, enquiryUrl: business.enquiryUrl, smsBase: smsHref }}>
      const form = document.getElementById('estimator');
      const out = document.getElementById('est-range');
      const note = document.getElementById('est-note');
      const cta = document.getElementById('est-cta');
      const money = (n) => '$' + (Math.round(n / 100) * 100).toLocaleString('en-AU');

      function update() {
        const f = new FormData(form);
        const num = (k) => Math.max(0, parseFloat(f.get(k)) || 0);
        const area = num('length') * num('width');
        const high = f.get('height') === 'high';
        const board = f.get('board');
        let total =
          area * ((est.perM2[board] || 0) + (high ? est.highDeckPerM2 : 0)) +
          num('steps') * est.perStep +
          num('bal') * est.balustradePerM +
          est.fixed;
        total = Math.max(total, est.minimum);
        out.textContent = area > 0 ? `${money(total * (1 - est.spread))} – ${money(total * (1 + est.spread))}` : '–';

        const notes = [`About ${area.toFixed(1)} m² of ${board.toLowerCase()} decking.`];
        if (high || area > 25) notes.push('Decks over 1 m high or 25 m² usually need council or certifier approval. I can help with that.');
        if (high && num('bal') === 0) notes.push('Decks over 1 m high need a balustrade.');
        note.textContent = notes.join(' ');

        // Without an online form, pre-fill the text message with the deck details.
        if (!enquiryUrl) {
          const msg = `${num('length')} x ${num('width')} m ${board} deck, ${high ? 'over' : 'under'} 1 m high, ${num('steps')} steps, ${num('bal')} m balustrade. My suburb is: `;
          cta.href = smsBase + encodeURIComponent(msg);
        }
      }
      form.addEventListener('input', update);
      update();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #1f1d1a;
    --muted: #5f5a53;
    --paper: #faf7f2;
    --band: #f0e9de;
    --timber: #9a5b2c;
    --timber-dark: #7a4520;
    --line: #ddd3c4;
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font: 17px/1.6 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  a { color: var(--timber-dark); }
  h1, h2, h3 { line-height: 1.15; margin: 0 0 0.6em; }
  h1 { font-size: clamp(2rem, 6vw, 3.4rem); letter-spacing: -0.02em; }
  h2 { font-size: clamp(1.5rem, 4vw, 2.1rem); }
  h3 { font-size: 1.15rem; }
  p { margin: 0 0 1em; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 16px; }
  .narrow { max-width: 720px; }
  .section { padding: 56px 0; }
  .band { background: var(--band); }
  .wrap.section { padding-left: 16px; padding-right: 16px; }
  .muted { color: var(--muted); }
  .small { font-size: 0.9rem; }

  .top { position: sticky; top: 0; z-index: 5; background: rgba(250, 247, 242, 0.95); border-bottom: 1px solid var(--line); backdrop-filter: blur(6px); }
  .top-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 60px; }
  .brand { font-weight: 800; text-decoration: none; color: var(--ink); }

  .hero { padding: 72px 0 64px; background: linear-gradient(160deg, var(--band), var(--paper) 70%); }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem; font-weight: 700; color: var(--timber-dark); }
  .lede { font-size: 1.15rem; max-width: 40ch; color: var(--muted); }

  .btn {
    display: inline-block; padding: 14px 22px; border-radius: 10px; border: 2px solid var(--timber);
    background: var(--timber); color: #fff; font-weight: 700; text-decoration: none; text-align: center;
  }
  .btn:hover { background: var(--timber-dark); border-color: var(--timber-dark); }
  .btn-ghost { background: transparent; color: var(--timber-dark); }
  .btn-ghost:hover { background: var(--band); color: var(--timber-dark); }
  .btn-small { padding: 8px 14px; font-size: 0.9rem; white-space: nowrap; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }

  .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .card { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 20px; }
  .card p { margin: 0; color: var(--muted); }

  .steps { padding-left: 1.3em; display: grid; gap: 10px; max-width: 760px; }

  .estimator {
    display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 20px; margin: 20px 0 16px;
  }
  .estimator label { display: grid; gap: 6px; font-weight: 600; font-size: 0.95rem; }
  .estimator input, .estimator select {
    font: inherit; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); width: 100%;
  }
  .result { border-left: 4px solid var(--timber); padding: 4px 0 4px 18px; }
  .result-label { margin: 0; font-weight: 600; color: var(--muted); }
  .result-value { font-size: clamp(1.8rem, 6vw, 2.6rem); font-weight: 800; margin: 0 0 6px; }

  .foot { border-top: 1px solid var(--line); padding: 28px 0; font-size: 0.9rem; color: var(--muted); }

  @media (max-width: 480px) {
    .cta-row .btn { flex: 1 1 100%; }
    .top .btn-small { font-size: 0.8rem; padding: 7px 10px; }
  }
</style>
