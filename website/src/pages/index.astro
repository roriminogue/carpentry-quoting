---
import Photo from '../components/Photo.astro';
import { business, services, priceSheet, hours, timbers, deckEstimate } from '../config';

const digits = (s: string) => s.replace(/\s/g, '');
const telHref = `tel:${digits(business.phone)}`;
const year = new Date().getFullYear();
const steps = [
  { title: 'Send the job', body: 'Fill in the form or text me: what you need, roughly how big, your suburb and a couple of photos.' },
  { title: 'Free measure-up', body: 'I come out, usually within the week, measure up and talk through timber and options.' },
  { title: 'Fixed written quote', body: 'Within two business days. What is included, what is not, and it holds for 30 days.' },
  { title: 'Built and finished', body: 'A 10% deposit books the start date. The balance is due when it is done and you are happy.' },
];
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{business.name} · Decks and carpentry in {business.area}</title>
    <meta
      name="description"
      content={`Licensed carpenter in ${business.area}. Hardwood decks, pergolas, doors and small renovations. Free measure-ups and fixed written quotes.`}
    />
    <meta name="theme-color" content="#121110" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <a class="wordmark" href="#top">{business.shortName}</a>
      <nav aria-label="Main">
        <a href="#services">Services</a>
        <a href="#price">Deck prices</a>
        <a href="#about">About</a>
      </nav>
      <a class="btn btn-sm" href="#contact">Get a quote</a>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-h">
        <Photo name="hero" alt="A finished hardwood deck at the back of a Sydney house" timber="#5a2f1c" eager class="hero-photo" />
        <div class="hero-content">
          <h1 id="hero-h" class="display">Built to Last.</h1>
          <p class="hero-line">
            Hardwood decks, pergolas and carpentry across {business.area}, from one licensed carpenter.
          </p>
          <div class="hero-actions">
            <a class="btn" href="#contact">Book a free measure-up</a>
            <a class="btn btn-light" href="#price">Price your deck</a>
          </div>
          <ul class="hero-facts" aria-label="Why book">
            <li>Licensed in NSW</li>
            <li>Free measure-ups</li>
            <li>Fixed written quotes</li>
          </ul>
        </div>
      </section>

      <section class="intro" aria-label="How I work">
        <p class="statement" data-reveal>
          One carpenter, start to finish. The person who quotes your job is the person who builds it.
        </p>
        <dl class="facts">
          <div data-reveal><dt>2 days</dt><dd>to a fixed, written quote after the measure-up</dd></div>
          <div data-reveal><dt>30 days</dt><dd>your quoted price holds, whatever timber does</dd></div>
          <div data-reveal><dt>10%</dt><dd>deposit to book, the most NSW allows. The rest on completion</dd></div>
        </dl>
      </section>

      <section id="services" class="services" aria-labelledby="services-h">
        <h2 id="services-h" class="display section-title">What I Build</h2>
        {services.map((s, i) => (
          <article class={`service ${i % 2 ? 'flip' : ''}`}>
            <Photo name={s.photo} alt={`${s.title}: a recent job`} timber={s.timber} turn={i % 2 === 1} class="service-photo" />
            <div class="service-text" data-reveal>
              <h3 class="display">{s.title}</h3>
              <p>{s.body}</p>
              <ul>
                {s.includes.map((x) => <li>{x}</li>)}
              </ul>
              <p class="from">{s.from}</p>
              <a class="text-link" href="#contact">Get a quote for this</a>
            </div>
          </article>
        ))}
      </section>

      <section id="price" class="price" aria-labelledby="price-h">
        <div class="price-head" data-reveal>
          <h2 id="price-h" class="display section-title">Price Your Deck</h2>
          <p>A ballpark in a minute. The real price comes after a free measure-up, fixed and in writing.</p>
        </div>
        <div class="price-body">
          <form id="deck-form" class="deck-form" data-reveal>
            <div class="pair">
              <div>
                <label for="f-length">Length (m)</label>
                <input id="f-length" name="length" type="number" inputmode="decimal" min="1" max="30" step="0.1" value="6" />
              </div>
              <div>
                <label for="f-width">Width (m)</label>
                <input id="f-width" name="width" type="number" inputmode="decimal" min="1" max="30" step="0.1" value="4" />
              </div>
            </div>
            <fieldset class="timbers">
              <legend>Timber</legend>
              {timbers.map((t, i) => (
                <label class="swatch" style={`--timber:${t.colour}`}>
                  <input type="radio" name="timber" value={t.name} checked={i === 0} />
                  <span class="chip" aria-hidden="true"></span>
                  <span>{t.name}</span>
                </label>
              ))}
            </fieldset>
            <div class="pair">
              <div>
                <label for="f-steps">Steps</label>
                <input id="f-steps" name="steps" type="number" inputmode="numeric" min="0" max="20" value="3" />
              </div>
              <div>
                <label for="f-bal">Balustrade (m)</label>
                <input id="f-bal" name="bal" type="number" inputmode="decimal" min="0" max="60" step="0.5" value="0" />
              </div>
            </div>
            <label class="check" for="f-high">
              <input id="f-high" name="high" type="checkbox" />
              More than 1 m off the ground
            </label>
          </form>

          <div class="result" data-reveal>
            <output class="result-total" for="deck-form" data-total aria-live="polite">$9,000 – $12,200</output>
            <p class="result-label">Ballpark, including GST</p>
            <p class="result-timber" data-timber-note>{timbers[0].note}</p>
            <ul class="lines" data-lines>
              <li><span>Deck, 24.0 m² of merbau, built and oiled</span><span>$9,480</span></li>
              <li><span>Stairs, 3 steps</span><span>$840</span></li>
              <li><span>Rubbish removal</span><span>$275</span></li>
            </ul>
            <p class="fine" data-fine>
              Deposit to book: 10%, about $1,060. Over $5,000, so this job gets a written NSW home building contract.
            </p>
            <a class="btn" href="#contact">Book a free measure-up</a>
          </div>
        </div>
      </section>

      <section class="process" aria-labelledby="process-h">
        <h2 id="process-h" class="display section-title">How It Works</h2>
        <ol>
          {steps.map((s) => (
            <li data-reveal>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="about" class="about" aria-labelledby="about-h">
        <Photo name="about" alt={`${business.owner} at work`} timber="#8f7457" turn class="about-photo" />
        <div class="about-text" data-reveal>
          <h2 id="about-h" class="display section-title">G'day, I'm {business.owner}.</h2>
          <p>
            I'm a licensed carpenter working across {business.area}. It's just me: no salesman, no subcontractors,
            and no surprises on the invoice.
          </p>
          <p>
            Every job is quoted in writing. Anything over $5,000 gets a proper NSW home building contract, and anything
            over $20,000 is covered by Home Building Compensation insurance before I take a cent.
          </p>
          <p>I'd rather build one deck well than three in a hurry.</p>
          <p class="licence">NSW contractor licence {business.licence}</p>
        </div>
      </section>

      <section class="prices" aria-labelledby="prices-h">
        <div class="prices-head" data-reveal>
          <h2 id="prices-h" class="display section-title">Price List</h2>
          <p>Starting prices, including GST. {hours[1]}.</p>
        </div>
        <div class="price-groups">
          {priceSheet.map((g) => (
            <div class="group" data-reveal>
              <h3>{g.group}</h3>
              <ul>
                {g.items.map((it) => (
                  <li><span>{it.name}</span><span class="amt">{it.price}</span></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section id="contact" class="contact" aria-labelledby="contact-h">
        <div class="contact-head" data-reveal>
          <h2 id="contact-h" class="display">Let's Build It.</h2>
          <p>Send the details and I'll call you within one business day to book a free measure-up.</p>
          <p class="direct">
            <a href={telHref}>{business.phone}</a>
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </p>
        </div>
        <form class="enquiry" id="enquiry" data-reveal>
          <div>
            <label for="c-name">Your name</label>
            <input id="c-name" name="name" autocomplete="name" required />
          </div>
          <div>
            <label for="c-phone">Mobile</label>
            <input id="c-phone" name="phone" type="tel" autocomplete="tel" required />
          </div>
          <div>
            <label for="c-suburb">Suburb</label>
            <input id="c-suburb" name="suburb" autocomplete="address-level2" required />
          </div>
          <div class="wide">
            <label for="c-job">The job</label>
            <textarea id="c-job" name="job" rows="3" required></textarea>
          </div>
          <button type="submit" class="btn wide">Send it to {business.owner}</button>
        </form>
      </section>
    </main>

    <footer class="foot">
      <p class="foot-mark display" aria-hidden="true">{business.shortName}</p>
      <div class="foot-row">
        <p>© {year} {business.name}</p>
        <p>ABN {business.abn} · NSW contractor licence {business.licence}</p>
        <p>{hours[0]}</p>
      </div>
    </footer>

    <script is:inline define:vars={{ timbers, est: deckEstimate, enquiryUrl: business.enquiryUrl, email: business.email, owner: business.owner }}>
      const money = new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD', maximumFractionDigits: 0 });
      const round100 = (n) => Math.round(n / 100) * 100;
      const $ = (s) => document.querySelector(s);
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Live deck price
      const form = $('#deck-form');
      function update() {
        const f = new FormData(form);
        const num = (k) => Math.max(0, parseFloat(f.get(k)) || 0);
        const area = num('length') * num('width');
        const t = timbers.find((x) => x.name === f.get('timber')) || timbers[0];
        const high = f.get('high') === 'on';
        const lines = [[`Deck, ${area.toFixed(1)} m² of ${t.name.toLowerCase()}, built and oiled`, area * (t.price + (high ? est.highDeckPerM2 : 0))]];
        if (num('steps')) lines.push([`Stairs, ${num('steps')} step${num('steps') === 1 ? '' : 's'}`, num('steps') * est.perStep]);
        if (num('bal')) lines.push([`Balustrade, ${num('bal')} m`, num('bal') * est.balustradePerM]);
        lines.push(['Rubbish removal', est.fixed]);
        const total = Math.max(lines.reduce((s, l) => s + l[1], 0), est.minimum);

        $('[data-lines]').replaceChildren(...lines.map(([name, amt]) => {
          const li = document.createElement('li');
          const a = document.createElement('span'); a.textContent = name;
          const b = document.createElement('span'); b.textContent = money.format(Math.round(amt));
          li.append(a, b);
          return li;
        }));
        $('[data-total]').textContent = area > 0
          ? `${money.format(round100(total * (1 - est.spread)))} – ${money.format(round100(total * (1 + est.spread)))}`
          : '–';
        $('[data-timber-note]').textContent = t.note;
        const fine = [`Deposit to book: 10%, about ${money.format(round100(total * 0.1))}.`];
        if (total > 20000) fine.push('Over $20,000, so it is covered by Home Building Compensation insurance and a full contract.');
        else if (total > 5000) fine.push('Over $5,000, so this job gets a written NSW home building contract.');
        if (high || area > 25) fine.push('Over 1 m high or 25 m² usually needs council or certifier approval. I can sort that out.');
        if (high && !num('bal')) fine.push('A deck over 1 m high needs a balustrade.');
        $('[data-fine]').textContent = fine.join(' ');

        const job = $('#c-job');
        if (!job.dataset.edited) job.value = `${num('length')} × ${num('width')} m ${t.name.toLowerCase()} deck${num('steps') ? `, ${num('steps')} steps` : ''}${num('bal') ? `, ${num('bal')} m balustrade` : ''}`;
      }
      form.addEventListener('input', update);
      form.addEventListener('submit', (e) => e.preventDefault());
      update();

      // Enquiry: ServiceM8's form if set, otherwise a pre-filled email.
      $('#c-job').addEventListener('input', (e) => { e.target.dataset.edited = '1'; });
      $('#enquiry').addEventListener('submit', (e) => {
        e.preventDefault();
        if (enquiryUrl) { location.href = enquiryUrl; return; }
        const f = new FormData(e.target);
        const body = `Hi ${owner},\n\nI'd like a free measure-up.\n\nName: ${f.get('name')}\nMobile: ${f.get('phone')}\nSuburb: ${f.get('suburb')}\nThe job: ${f.get('job')}\n`;
        location.href = `mailto:${email}?subject=${encodeURIComponent('Measure-up request: ' + f.get('suburb'))}&body=${encodeURIComponent(body)}`;
      });

      // Nav gets a solid background once the hero has scrolled away
      const nav = $('.nav');
      const onScroll = () => nav.classList.toggle('solid', scrollY > innerHeight * 0.6);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Entrances: content is visible without script; with it, parts rise in as they arrive.
      if (!still && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('motion');
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => {
            if (!en.isIntersecting) return;
            en.target.classList.add('in');
            io.unobserve(en.target);
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('[data-reveal], .hero-content > *, .service-photo, .about-photo').forEach((el, i) => {
          el.style.setProperty('--d', `${(i % 4) * 80}ms`);
          io.observe(el);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* Rugged premium: near-black like a charred post, warm bone text, one oiled-timber amber
     for actions. Large, tightly set Instrument Sans in title case; full-bleed job photos carry the page. */
  :root {
    --bg: #121110;
    --surface: #1b1917;
    --surface-2: #26231f;
    --ink: #ebe8e4;
    --muted: #aaa49d;
    --accent: #d49b48;
    --accent-press: #e4ad5c;
    --accent-ink: #121110;
    --light: #ebe8e4;

    --face: 'Instrument Sans', 'Helvetica Neue', Arial, sans-serif;
    --step-small: 0.875rem;
    --step-body: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    --step-lead: clamp(1.375rem, 1.1rem + 0.9vw, 2rem);
    --step-head: clamp(2.5rem, 1.6rem + 4vw, 5.5rem);
    --step-hero: clamp(3.5rem, 1rem + 10vw, 10rem);

    --side: max(20px, env(safe-area-inset-left, 0px));
    --side-r: max(20px, env(safe-area-inset-right, 0px));
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  html { scroll-padding-top: 80px; }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font: 400 var(--step-body) / 1.55 var(--face); -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3, p, dl, dd { margin: 0; }
  a { color: inherit; }
  img { max-width: 100%; }
  :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .skip { position: absolute; left: 12px; top: -80px; background: var(--accent); color: var(--accent-ink); padding: 10px 14px; z-index: 30; }
  .skip:focus { top: 12px; }

  .display {
    font-weight: 500;
    letter-spacing: -0.045em; line-height: 0.95; text-wrap: balance;
  }
  .section-title { font-size: var(--step-head); }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 54px; padding: 0 26px;
    background: var(--accent); color: var(--accent-ink); border: 0; cursor: pointer; text-decoration: none;
    font: 700 var(--step-body) / 1 var(--face); transition: background-color 160ms ease, transform 120ms ease;
  }
  .btn:hover { background: var(--accent-press); }
  .btn:active { transform: translateY(1px) scale(0.985); }
  .btn-light { background: var(--light); color: var(--accent-ink); }
  .btn-light:hover { background: #fff; }
  .btn-sm { min-height: 44px; padding: 0 18px; font-size: var(--step-small); }
  .text-link { color: var(--accent); font-weight: 700; text-underline-offset: 0.2em; }
  .text-link:hover { color: var(--accent-press); }

  /* Photos and their timber stand-ins */
  .photo { display: block; width: 100%; height: 100%; object-fit: cover; }
  .photo-standin { position: relative; overflow: hidden; background: #0c0a08; }
  .photo-standin .deck-plan { position: absolute; inset: -20%; width: 140%; height: 140%; }
  .photo-standin.turn .deck-plan { transform: rotate(90deg); }
  .deck-gap { fill: #0c0a08; }
  .deck-board { fill: var(--timber); }
  .deck-tone { fill: #000; }
  .deck-screw { fill: #0c0a08; opacity: 0.6; }
  .photo-note {
    position: absolute; right: 12px; top: 12px; padding: 6px 10px; background: rgba(18, 17, 16, 0.8);
    color: var(--muted); font-size: var(--step-small);
  }

  .hero-photo .photo-note { top: calc(84px + env(safe-area-inset-top, 0px)); }

  /* Nav */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 20; display: flex; align-items: center; gap: 28px;
    padding: calc(14px + env(safe-area-inset-top, 0px)) var(--side-r) 14px var(--side);
    transition: background-color 240ms ease;
  }
  .nav.solid { background: var(--bg); }
  .wordmark { font-weight: 600; font-size: var(--step-body); text-decoration: none; letter-spacing: -0.02em; margin-right: auto; }
  .nav nav { display: flex; gap: 24px; font-size: var(--step-small); font-weight: 600; }
  .nav nav a { text-decoration: none; }
  .nav nav a:hover { color: var(--accent); }

  /* Hero */
  .hero { position: relative; min-height: 100svh; display: grid; align-items: end; overflow: hidden; }
  .hero-photo { position: absolute; inset: 0; }
  .hero::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to top, rgba(18, 17, 16, 0.92) 8%, rgba(18, 17, 16, 0.35) 55%, rgba(18, 17, 16, 0.25)); /* taste-skill-ignore: scrim under text */
  }
  .hero-content { position: relative; z-index: 1; padding: 140px var(--side-r) 40px var(--side); display: grid; gap: 28px; }
  .hero h1 { font-size: var(--step-hero); }
  .hero-line { font-size: var(--step-lead); max-width: 34ch; line-height: 1.3; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-facts { list-style: none; padding: 22px 0 0; margin: 12px 0 0; display: flex; flex-wrap: wrap; gap: 8px 40px; color: var(--muted); font-weight: 600; font-size: var(--step-small); }

  /* Intro */
  .intro { padding: 180px var(--side-r) 0 var(--side); display: grid; gap: 96px; }
  .statement { font-size: var(--step-lead); line-height: 1.2; font-weight: 600; letter-spacing: -0.015em; max-width: 34ch; }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .facts dt { font-size: var(--step-head); font-weight: 500; letter-spacing: -0.045em; line-height: 0.95; color: var(--accent); font-variant-numeric: tabular-nums; }
  .facts dd { margin-top: 12px; max-width: 26ch; color: var(--muted); }

  /* Services: big photo beside text, alternating */
  .services { padding: 200px 0 0; }
  .services .section-title { padding: 0 var(--side-r) 64px var(--side); }
  .service { display: grid; grid-template-columns: 7fr 5fr; min-height: 78svh; background: var(--surface); }
  .service + .service { margin-top: 12px; }
  .service.flip { grid-template-columns: 5fr 7fr; }
  .service.flip .service-photo { order: 2; }
  .service-photo { min-height: 420px; }
  .service-text { padding: 64px clamp(24px, 4vw, 72px); display: flex; flex-direction: column; justify-content: center; gap: 22px; }
  .service h3 { font-size: var(--step-head); }
  .service-text > p:first-of-type { max-width: 44ch; }
  .service ul { margin: 0; padding: 0 0 0 1.1em; display: grid; gap: 6px; color: var(--muted); }
  .from { font-weight: 700; font-size: var(--step-lead); }

  /* Price your deck */
  .price { padding: 200px var(--side-r) 0 var(--side); }
  .price-head { display: grid; gap: 20px; margin-bottom: 64px; }
  .price-head p { max-width: 50ch; color: var(--muted); }
  .price-body { display: grid; grid-template-columns: 5fr 7fr; gap: 12px; }
  .deck-form { background: var(--surface); padding: 40px; display: grid; gap: 26px; align-content: start; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .deck-form label, .deck-form legend { display: block; font-size: var(--step-small); font-weight: 600; color: var(--muted); margin-bottom: 6px; }
  .deck-form input[type='number'] {
    width: 100%; font: 600 var(--step-lead) / 1 var(--face); font-variant-numeric: tabular-nums; padding: 14px 16px;
    background: var(--surface-2); color: var(--ink); border: 0; border-bottom: 3px solid #3a3530; border-radius: 0;
  }
  .deck-form input[type='number']:focus { outline: none; border-bottom-color: var(--accent); }
  .timbers { border: 0; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .deck-form .swatch { display: flex; align-items: center; gap: 10px; padding: 12px; margin: 0; background: var(--surface-2); cursor: pointer; color: var(--ink); font-size: var(--step-small); transition: background-color 160ms ease; }
  .deck-form .swatch:hover { background: #312c27; }
  .swatch input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .chip { width: 22px; height: 22px; background: var(--timber); flex: none; }
  .deck-form .swatch:has(input:checked) { background: var(--ink); color: var(--accent-ink); }
  .swatch:has(input:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }
  .deck-form .check { display: flex; gap: 10px; align-items: center; cursor: pointer; color: var(--ink); font-size: var(--step-body); margin: 0; }
